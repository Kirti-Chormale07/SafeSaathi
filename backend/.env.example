# ---- SafeSaathi backend configuration -------------------------------------
# Copy this file to `.env` (same folder) and fill in whatever you have.
# EVERYTHING is optional: with no keys the app runs in built-in heuristic
# "demo mode" (rule-based scam detection) so the project always starts.

# LLM for scam reasoning + explanations (pick one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Override the model if you want (defaults: claude-3-5-sonnet-latest / gpt-4o-mini)
LLM_MODEL=

# Link reputation
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=

# Guardian alert (Twilio WhatsApp/SMS). Leave empty to use the free
# WhatsApp "wa.me" pre-filled link instead (works with zero setup).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Default guardian number used for the Twilio path, e.g. +919999999999
GUARDIAN_DEFAULT=

# Server
HOST=127.0.0.1
# NOTE: use 8010, not 8000 - port 8000 is vLLM's default and the OpenCode
# desktop app probes it every 30s (harmless but noisy in the logs).
PORT=8010
CORS_ORIGINS=http://localhost:3000
